{
  "info": {
    "name": "TP Backend API",
    "description": "Colección de Postman para probar los endpoints del backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "workspaceId",
      "value": "",
      "type": "string"
    },
    {
      "key": "channelId",
      "value": "",
      "type": "string"
    },
    {
      "key": "messageId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan\",\n  \"email\": \"juan@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.access_token) {",
                  "  pm.collectionVariables.set('accessToken', json.data.access_token);",
                  "  console.log('Token guardado');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-email?verifyToken=TOKEN_AQUI&email=juan@example.com",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-email"],
              "query": [
                { "key": "verifyToken", "value": "TOKEN_AQUI" },
                { "key": "email", "value": "juan@example.com" }
              ]
            }
          }
        },
        {
          "name": "Request Password Reset",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/request-password-reset",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "request-password-reset"]
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resetToken\": \"TOKEN_AQUI\",\n  \"newPassword\": \"nuevacontraseña123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "reset-password"]
            }
          }
        }
      ]
    },
    {
      "name": "Workspace",
      "item": [
        {
          "name": "Create Workspace",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Equipo de Producto\",\n  \"descripcion\": \"Workspace para pruebas\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workspace",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspace"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.workspace && json.data.workspace._id) {",
                  "  pm.collectionVariables.set('workspaceId', json.data.workspace._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get My Workspaces",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/workspace",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspace"]
            }
          }
        },
        {
          "name": "Get Workspace Members",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/workspace/{{workspaceId}}/members",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspace", "{{workspaceId}}", "members"]
            }
          }
        },
        {
          "name": "Invite Member",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invitado@example.com\",\n  \"rol\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workspace/{{workspaceId}}/invite",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspace", "{{workspaceId}}", "invite"]
            }
          }
        },
        {
          "name": "Get Workspace Channels",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/workspace/{{workspaceId}}/channels",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspace", "{{workspaceId}}", "channels"]
            }
          }
        },
        {
          "name": "Create Channel",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Soporte\",\n  \"descripcion\": \"Canal de soporte\",\n  \"memberIds\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workspace/{{workspaceId}}/channels",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspace", "{{workspaceId}}", "channels"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.channel && json.data.channel._id) {",
                  "  pm.collectionVariables.set('channelId', json.data.channel._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Channel",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Soporte Actualizado\",\n  \"descripcion\": \"Canal actualizado\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workspace/{{workspaceId}}/channels/{{channelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspace", "{{workspaceId}}", "channels", "{{channelId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Get Channel Messages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/channels/{{channelId}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "channels", "{{channelId}}", "messages"]
            }
          }
        },
        {
          "name": "Get New Messages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/channels/{{channelId}}/messages/new?after=2026-01-01T00:00:00.000Z",
              "host": ["{{baseUrl}}"],
              "path": ["api", "channels", "{{channelId}}", "messages", "new"],
              "query": [{ "key": "after", "value": "2026-01-01T00:00:00.000Z" }]
            }
          }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hola desde Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/channels/{{channelId}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "channels", "{{channelId}}", "messages"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.message && json.data.message._id) {",
                  "  pm.collectionVariables.set('messageId', json.data.message._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Message",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Mensaje editado desde Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/channels/{{channelId}}/messages/{{messageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "channels", "{{channelId}}", "messages", "{{messageId}}"]
            }
          }
        },
        {
          "name": "Delete Message",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/channels/{{channelId}}/messages/{{messageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "channels", "{{channelId}}", "messages", "{{messageId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "profile"]
            }
          }
        }
      ]
    }
  ]
}
